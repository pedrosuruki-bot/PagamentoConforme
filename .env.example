# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=PagamentoConforme
SECRET_KEY=replace-with-a-long-random-secret-before-deploy
DATABASE_URL=sqlite:///./pagamentoconforme.db
PRIVATE_STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800
BASE_URL=http://127.0.0.1:8000

# Optional private Supabase Storage integration. Keep service-role keys server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-documents

# Optional Stripe Billing integration. Use test-mode keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASE=

# Optional transactional email.
RESEND_API_KEY=
EMAIL_FROM=

# Optional payment profile values for a bank-specific SEPA XML export.
PAYMENT_CREDITOR_BIC=
